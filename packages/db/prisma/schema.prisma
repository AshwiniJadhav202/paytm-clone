generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                      @id @default(autoincrement())
  email               String?                  @unique
  name                String?
  number              String                   @unique
  password            String
  balancePin          String?
  Balance             Balance?
  demoBankAccounts    DemoBankAccount[]
  paidPaymentRequests MerchantPaymentRequest[] @relation("UserPaymentRequests")
  OnRampTransaction   OnRampTransaction[]
  sentTransfers       p2pTransfer[]            @relation("FromUserRelation")
  receivedTransfers   p2pTransfer[]            @relation("ToUserRelation")
}

model Bank {
  id          Int    @id @default(autoincrement())
  name        String @unique
  redirectUrl String
}

model Merchant {
  id              Int                      @id @default(autoincrement())
  email           String                   @unique
  name            String?
  auth_type       AuthType
  paymentRequests MerchantPaymentRequest[]
}

model MerchantPaymentRequest {
  id           Int                  @id @default(autoincrement())
  merchantId   Int
  amount       Int
  description  String?
  token        String               @unique
  status       PaymentRequestStatus @default(Pending)
  createdAt    DateTime             @default(now())
  paidAt       DateTime?
  paidByUserId Int?
  merchant     Merchant             @relation(fields: [merchantId], references: [id])
  paidByUser   User?                @relation("UserPaymentRequests", fields: [paidByUserId], references: [id])
}

model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model p2pTransfer {
  id         Int      @id @default(autoincrement())
  amount     Int
  fromUserId Int
  toUserId   Int
  timestamp  DateTime
  fromUser   User     @relation("FromUserRelation", fields: [fromUserId], references: [id])
  toUser     User     @relation("ToUserRelation", fields: [toUserId], references: [id])
}

model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int
  locked Int
  user   User @relation(fields: [userId], references: [id])
}

model DemoBankAccount {
  id            Int      @id @default(autoincrement())
  userId        Int
  bankName      String
  accountNumber String
  accountHolder String
  balance       Int      @default(100000)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, bankName])
}

model DemoBankTransfer {
  id            Int          @id @default(autoincrement())
  userId        Int
  bankAccountId Int
  amount        Int
  status        OnRampStatus @default(Success)
  token         String       @unique
  createdAt     DateTime     @default(now())
}

model RazorpayPayment {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  paymentId String   @unique
  amount    Int?
  currency  String   @default("INR")
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}

enum AuthType {
  Google
  Github
}

enum OnRampStatus {
  Success
  Failure
  Processing
}

enum PaymentRequestStatus {
  Pending
  Success
  Failed
  Expired
}
