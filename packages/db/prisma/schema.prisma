
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                          Int                   @id @default(autoincrement())
  email                                       String?               @unique
  name                                        String?
  number                                      String                @unique
  password                                    String
  balance                                     Int                   @default(10000)
  balancePin                                  String?
  BankAccount                                 BankAccount[]
  MerchantTransaction                         MerchantTransaction[]
  MoneyRequest_MoneyRequest_payerIdToUser     MoneyRequest[]        @relation("MoneyRequest_payerIdToUser")
  MoneyRequest_MoneyRequest_requesterIdToUser MoneyRequest[]        @relation("MoneyRequest_requesterIdToUser")
  Payment                                     Payment[]
  PaymentAttempt                              PaymentAttempt[]
  Transaction_Transaction_receiverIdToUser    Transaction[]         @relation("Transaction_receiverIdToUser")
  Transaction_Transaction_senderIdToUser      Transaction[]         @relation("Transaction_senderIdToUser")

  // Password Reset
  passwordResetTokens                         PasswordResetToken[]
}

model Merchant {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  name                String?
  auth_type           AuthType
  balance             Int                   @default(0)
  MerchantTransaction MerchantTransaction[]
  Payment             Payment[]
}

model BankAccount {
  id             Int              @id @default(autoincrement())
  userId         Int
  bankName       String
  maskedAccount  String
  ifsc           String?
  provider       String
  providerRef    String           @unique
  status         String           @default("ACTIVE")
  isPrimary      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  User           User             @relation(fields: [userId], references: [id])
  PaymentAttempt PaymentAttempt[]
}

model MerchantTransaction {
  id         Int      @id @default(autoincrement())
  userId     Int
  merchantId Int
  amount     Int
  createdAt  DateTime @default(now())
  Merchant   Merchant @relation(fields: [merchantId], references: [id])
  User       User     @relation(fields: [userId], references: [id])
}

model MoneyRequest {
  id                                  Int      @id @default(autoincrement())
  requesterId                         Int
  payerId                             Int
  amount                              Int
  status                              String   @default("PENDING")
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime
  User_MoneyRequest_payerIdToUser     User     @relation("MoneyRequest_payerIdToUser", fields: [payerId], references: [id])
  User_MoneyRequest_requesterIdToUser User     @relation("MoneyRequest_requesterIdToUser", fields: [requesterId], references: [id])
}

model Payment {
  id                Int           @id @default(autoincrement())
  userId            Int?
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  merchantId        Int?
  Merchant          Merchant?     @relation(fields: [merchantId], references: [id])
  User              User?         @relation(fields: [userId], references: [id])
}

model PaymentAttempt {
  id                Int              @id @default(autoincrement())
  userId            Int
  bankAccountId     Int?
  amount            Int
  currency          String           @default("INR")
  provider          String
  providerPaymentId String?           @unique
  status            PaymentStatus    @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  BankAccount       BankAccount?     @relation(fields: [bankAccountId], references: [id])
  User              User             @relation(fields: [userId], references: [id])
}

model Transaction {
  id                                Int      @id @default(autoincrement())
  senderId                          Int
  receiverId                        Int
  amount                            Int
  createdAt                         DateTime @default(now())
  User_Transaction_receiverIdToUser User     @relation("Transaction_receiverIdToUser", fields: [receiverId], references: [id])
  User_Transaction_senderIdToUser   User     @relation("Transaction_senderIdToUser", fields: [senderId], references: [id])
}

model WebhookEvent {
  id        Int      @id @default(autoincrement())
  provider  String
  eventId   String   @unique
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// =====================================================
// PASSWORD RESET TOKEN
// =====================================================

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthType {
  Google
  Github
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}